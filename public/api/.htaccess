# ==============================================================================
# Covent Garden Bilbao · Protección del directorio API (/api)
# ==============================================================================

# Bloquear acceso directo a archivos de configuración interna, plantillas y volcados
<FilesMatch "^(config.*\.php|\.env.*|.*\.json|.*\.log|.*\.bak|.*\.ini)$">
    <IfModule mod_authz_core.c>
        Require all denied
    </IfModule>
    <IfModule !mod_authz_core.c>
        Order allow,deny
        Deny from all
    </IfModule>
</FilesMatch>
