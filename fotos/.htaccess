# ==============================================================================
# Covent Garden Bilbao · Protección del gestor de fotografías (/fotos)
# ==============================================================================

# Impedir acceso directo a archivos de configuración y datos sensibles
<FilesMatch "^(config.*\.php|\.env.*|\.git.*|.*\.json|.*\.log|.*\.bak|.*\.sql)$">
    <IfModule mod_authz_core.c>
        Require all denied
    </IfModule>
    <IfModule !mod_authz_core.c>
        Order allow,deny
        Deny from all
    </IfModule>
</FilesMatch>
